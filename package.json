{
  "name": "hooksmith",
  "version": "0.1.0",
  "description": "Cross-agent PreToolUse hook that decomposes, explains and risk-classifies Bash commands before the approval prompt (Claude Code + Codex CLI).",
  "type": "module",
  "bin": {
    "explain-cmd": "dist/cli.js"
  },
  "files": [
    "dist",
    "config"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "watch": "tsc -p tsconfig.json --watch",
    "test": "npm run build && node --test dist/core/core.test.js",
    "prepublishOnly": "npm run build"
  },
  "engines": {
    "node": ">=20"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.20.1",
    "typescript": "^5.7.2"
  }
}
